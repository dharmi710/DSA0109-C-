#include<iostream>
using namespace std;

int main() {
    int n,temp,r,sum=0,f;
    cin>>n;
    temp=n;
    while(n>0){
        r=n%10;
        f=1;
        for(int i=1;i<=r;i++)
            f*=i;
        sum+=f;
        n/=10;
    }
    if(sum==temp)
        cout<<"Strong";
    else
        cout<<"Not Strong";
    return 0;
}
